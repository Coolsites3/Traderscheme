# Register an app at https://api.deriv.com / Application manager
# App ID 1089 is Deriv's public demo app — replace it with yours in production.
NEXT_PUBLIC_DERIV_APP_ID=1089

# Optional OAuth client fields (legacy implicit OAuth uses app_id only)
NEXT_PUBLIC_DERIV_OAUTH_CLIENT_ID=
NEXT_PUBLIC_DERIV_REDIRECT_URI=http://localhost:3000/api/auth/deriv/callback
DERIV_CLIENT_SECRET=

# Affiliate tagging — from your Deriv partner / sidc referral link
NEXT_PUBLIC_DERIV_AFFILIATE_TOKEN=
NEXT_PUBLIC_DERIV_UTM_CAMPAIGN=

NEXT_PUBLIC_DERIV_API_URL=wss://ws.binaryws.com/websockets/v3
NEXT_PUBLIC_DERIV_OAUTH_URL=https://oauth.deriv.com/oauth2/authorize

# Display-only payout haircut shown in the trading panel
NEXT_PUBLIC_DERIV_MARKUP_PERCENT=3
